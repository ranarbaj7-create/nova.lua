-- ==================== [ ФУНКЦИИ БАРЬЕРА, HEADSIT И ANTI-SIT ] ====================
local isBypassActive = false
local isHeadsitActive = false
local isAntiSitActive = false

local function destroyBarrier(obj)
    if not obj:IsA("BasePart") and not obj:IsA("Model") then return end
    local name = string.lower(obj.Name)
    if string.find(name, "ban") or string.find(name, "barrier") or string.find(name, "houseban") or string.find(name, "dome") or string.find(name, "shield") or string.find(name, "field") then
        pcall(function() obj:Destroy() end)
    end
end

local workspaceConn
BypassBtn.MouseButton1Click:Connect(function()
    isBypassActive = not isBypassActive
    if isBypassActive then
        for _, obj in ipairs(Workspace:GetDescendants()) do destroyBarrier(obj) end
        workspaceConn = Workspace.DescendantAdded:Connect(function(child)
            if isBypassActive then task.spawn(function() task.wait(0.05) destroyBarrier(child) end) end
        end)
        TweenService:Create(BypassBtn, TweenInfo.new(0.3), {BackgroundTransparency = 0.75}):Play()
        TweenService:Create(StatusDot1, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(60, 255, 120)}):Play()
    else
        if workspaceConn then workspaceConn:Disconnect() end
        TweenService:Create(BypassBtn, TweenInfo.new(0.3), {BackgroundTransparency = 0.85}):Play()
        TweenService:Create(StatusDot1, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(255, 60, 60)}):Play()
    end
end)

HeadsitBtn.MouseButton1Click:Connect(function()
    if not selectedTargetPlayer or not selectedTargetPlayer.Character then
        showToast("Сначала выберите жертву!", Color3.fromRGB(220, 50, 50))
        return
    end
    
    isHeadsitActive = not isHeadsitActive
    
    if isHeadsitActive then
        TweenService:Create(HeadsitBtn, TweenInfo.new(0.3), {BackgroundTransparency = 0.75}):Play()
        TweenService:Create(StatusDot2, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(60, 255, 120)}):Play()
    else
        isHeadsitActive = false
        local myChar = LocalPlayer.Character
        if myChar then
            local hum = myChar:FindFirstChild("Humanoid")
            local root = myChar:FindFirstChild("HumanoidRootPart")
            if hum then hum.Sit = false end
            if root then
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                root.CFrame = root.CFrame + Vector3.new(3, 2, 0)
            end
        end
        TweenService:Create(HeadsitBtn, TweenInfo.new(0.3), {BackgroundTransparency = 0.85}):Play()
        TweenService:Create(StatusDot2, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(255, 60, 60)}):Play()
    end
end)

-- Логика Anti-Sit
AntiSitBtn.MouseButton1Click:Connect(function()
    isAntiSitActive = not isAntiSitActive
    if isAntiSitActive then
        TweenService:Create(AntiSitBtn, TweenInfo.new(0.3), {BackgroundTransparency = 0.75}):Play()
        TweenService:Create(StatusDot3, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(60, 200, 120)}):Play()
