    else
        TweenService:Create(AntiSitBtn, TweenInfo.new(0.3), {BackgroundTransparency = 0.85}):Play()
        TweenService:Create(StatusDot3, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(255, 60, 60)}):Play()
        showToast("Anti-Sit выключен", Color3.fromRGB(230, 150, 30))
    end
end)

RunService.Heartbeat:Connect(function()
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHumanoid = myChar:FindFirstChildOfClass("Humanoid")
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    
    -- Работа Anti-Sit (постоянно сбрасываем статус посадки)
    if isAntiSitActive and myHumanoid then
        if myHumanoid.Sit then
            myHumanoid.Sit = false
        end
        if myRoot and myHumanoid.SeatPart then
            myHumanoid.SeatPart = nil
        end
    end
    
    -- Работа Headsit
    if isHeadsitActive and selectedTargetPlayer and selectedTargetPlayer.Character then
        local targetChar = selectedTargetPlayer.Character
        local targetHead = targetChar:FindFirstChild("Head")
        
        if targetHead and myRoot and myHumanoid then
            myHumanoid.Sit = true
            myRoot.CFrame = targetHead.CFrame + Vector3.new(0, 2.2, 0)
            myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end
end)

